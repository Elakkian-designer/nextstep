{
  "name": "Next Step",
  "short_name": "Next Step",
  "description": "Next Step — study companion for TNPSC Group 2 preparation",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#075E54",
  "theme_color": "#075E54",
  "icons": [
    {
      "src": "next-step-icon.jpg",
      "sizes": "192x192",
      "type": "image/jpeg",
      "purpose": "any"
    },
    {
      "src": "next-step-icon.jpg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any"
    },
    {
      "src": "next-step-icon.jpg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Study Materials & Documents",
      "accept": {
        "application/pdf": [".pdf"],
        "image/*": [".jpg", ".png", ".webp", ".jpeg", ".gif"],
        "video/*": [".mp4", ".mkv", ".webm"],
        "audio/*": [".mp3", ".wav", ".m4a", ".ogg"],
        "text/plain": [".txt", ".md"]
      }
    }
  ]
}
